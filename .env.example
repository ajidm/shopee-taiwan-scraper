PORT=3000

# Shopee region to scrape. Task target is shopee.tw (default). Overridable for
# validation/testing against another region sharing the same get_pc/get_rw API shape
# (e.g. shopee.co.id) — see README.md "Mode Guest vs Login" and the experiment notes
# under "Batasan yang Diketahui".
SHOPEE_DOMAIN=shopee.tw

# Concurrency limit for outgoing Shopee requests (keep low to avoid detection)
CONCURRENCY_LIMIT=4

# Minimum/maximum jitter delay (ms) between outgoing requests
REQUEST_DELAY_MIN_MS=300
REQUEST_DELAY_MAX_MS=1500

# How often (ms) the Playwright session (cookies/headers) is proactively refreshed
SESSION_REFRESH_INTERVAL_MS=600000

# Proxy mode: "sticky" (default) keeps one IP for a session's whole lifetime (bootstrap +
# follow-up axios calls) since Shopee's cookies/tokens are IP-bound. "rotating" picks a
# fresh IP on every proxy lookup — only use it if your provider's sessions don't need
# IP continuity, since mixing IPs mid-session will usually invalidate the cookies.
PROXY_MODE=sticky

# Comma-separated list of proxy URLs for sticky mode, e.g. http://user:pass@host:port
# Leave empty to run without a proxy (uses local/ngrok host IP directly)
PROXY_LIST=

# Comma-separated list of proxy URLs for rotating mode (only used when PROXY_MODE=rotating)
PROXY_ROTATING_LIST=

LOG_LEVEL=info

# Browser engine + stealth combination (technique #2). Options:
#   rebrowser        - rebrowser-playwright (CDP leak patch) + stealth plugin (default, recommended)
#   vanilla-stealth   - stock "playwright" package (no CDP patch) + stealth plugin
#   vanilla           - stock "playwright" package, no stealth at all (original failing baseline)
BROWSER_ENGINE=rebrowser

# Optional: override the Chrome/Chromium binary used by rebrowser-playwright.
# Leave empty to use the default staged by `npm run setup:browser` (macOS).
CHROME_EXECUTABLE_PATH=

# Experimental: launch the actually-installed Chrome stable via Playwright's own channel
# resolution (e.g. "chrome") instead of the pinned Chrome-for-Testing binary. Only meaningful
# with BROWSER_ENGINE=vanilla or vanilla-stealth — rebrowser-playwright's CDP patches assume
# the Chrome-for-Testing revision they were built against and crash against Chrome stable.
BROWSER_CHANNEL=

# BROWSER_ENGINE also accepts "patchright" — a more thorough undetected-Playwright fork than
# rebrowser-playwright (avoids Runtime.enable entirely via isolated execution contexts,
# patches the Console.enable leak, strips --enable-automation). Requires `npm i patchright &&
# npx patchright install chromium` once. See README "Batasan yang Diketahui" for test results.

# Set to "false" to watch the browser visually while debugging (default: headless).
HEADLESS=true

# Experimental: "mobile" emulates an iOS Safari mobile-web browser (viewport, touch, User-
# Agent) instead of desktop. Hypothesis: Shopee's WAF may trust mobile-web traffic more than
# desktop. Tested — did not change the outcome (see README "Batasan yang Diketahui").
DEVICE_EMULATION=desktop

# Set to "true" to skip loading images/fonts/stylesheets (saves bandwidth on paid proxies),
# but this can itself be a detectable signal (real browsers finish loading these). Off by default.
BLOCK_STATIC_ASSETS=false

# Experimental: "warmup" visits the Shopee homepage first with a random idle delay before
# navigating to the product page, instead of deep-linking straight in. "click" goes further:
# lands on the homepage, then injects a link to the exact target URL and clicks it (a
# genuine, trusted CDP-level click event) instead of page.goto() straight to the product.
# "auto" tries "direct" first (fast) and only falls back to "click" (slower, extra homepage
# hop) if direct comes back with no usable item or hits the traffic-verification wall —
# recommended when you don't know in advance which will work for a given product/session.
# Validated to matter empirically — see README "Known Limitations" for the breakthrough this
# came from. Default: direct.
NAVIGATION_STRATEGY=direct

# Experimental: reuse one long-lived browser profile (cookies/localStorage) across all
# bootstraps instead of a fresh context each time. Off by default.
PERSISTENT_PROFILE=false

# Route get_pc/get_rw calls through page.evaluate(fetch(...)) inside the real Chromium
# context instead of axios. On by default: public research on Shopee's anti-fraud headers
# indicates the per-request signature is bound to a device-local sequence counter that only
# advances correctly when the fetch is executed by the same browser instance holding the
# session — an axios replay of captured headers tends to desync after the first request.
# Set to "false" to use axios instead (faster, but expect it to degrade quickly).
IN_BROWSER_FETCH=true

# How long (ms) to back off from re-bootstrapping a product after it hits Shopee's
# traffic-verification wall, instead of immediately retrying (which likely worsens things).
BLOCKED_COOLDOWN_MS=300000

# "guest" (default): sessions bootstrap from a blank, anonymous browser context, matching
# this task's original scope (public/anonymous scraping, no personal account involved).
# "login": sessions bootstrap by loading a previously-authenticated storage state (cookies +
# localStorage) instead. This does NOT automate the login form itself — run `npm run login`
# once to log in manually in a real visible browser (handles OTP/captcha yourself) and save
# the resulting session. Falls back to guest with a warning if the file is missing.
AUTH_MODE=guest

# Where `npm run login` saves (and AUTH_MODE=login loads) the authenticated storage state.
# Contains live session cookies — treat it like a password, never commit it (.auth/ is
# gitignored by default).
LOGIN_STORAGE_STATE_PATH=./.auth/shopee-login-state.json
